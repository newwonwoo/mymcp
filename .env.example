AWS_REGION=ap-northeast-2
STAGE=dev
API_KEY=replace-with-64-char-random-string

ROLES_TABLE=mcp-hub-roles-dev
PROMPTS_TABLE=mcp-hub-prompts-dev
PROJECTS_TABLE=mcp-hub-projects-dev
PRESETS_TABLE=mcp-hub-presets-dev
SESSIONS_TABLE=mcp-hub-sessions-dev
MISTAKES_TABLE=mcp-hub-mistakes-dev
PHASES_TABLE=mcp-hub-phases-dev
FAILURE_STORIES_TABLE=mcp-hub-failure-stories-dev
DECISIONS_TABLE=mcp-hub-decisions-dev

